# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_APP_URL=http://localhost:5173

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000

# SQLite persistence (mounted volume path in Railway/OpenShift)
DATABASE_PATH=/data/safe2devops.sqlite3

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Jira Cloud (server-side only; never expose to the browser)
JIRA_SITE_URL=
JIRA_SERVICE_ACCOUNT_EMAIL=
JIRA_API_TOKEN=

# Azure DevOps Services (server-side only; never expose to the browser)
AZDO_ORG_URL=
AZDO_PAT=

# Session / security
SESSION_SECRET=
CORS_ORIGINS=http://localhost:5173

# Deployment notes
# - Use exactly one application replica while SQLite is the store.
# - Mount persistent storage at the directory containing DATABASE_PATH.
