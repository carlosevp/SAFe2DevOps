# Application
APP_ENV=development
PORT=8000
DATA_DIR=./data

# Derived at runtime when unset:
# DATABASE_URL=sqlite:///./data/db/safedevops.db
# UPLOAD_DIR=./data/uploads
# EXPORT_DIR=./data/exports
# EVIDENCE_DIR=./data/evidence
# BACKUP_DIR=./data/backups
# WORKING_DIR=./data/working

DATABASE_URL=
UPLOAD_DIR=
EXPORT_DIR=
EVIDENCE_DIR=
BACKUP_DIR=
WORKING_DIR=

# Security (required in staging/production; auto-generated in development/test if empty)
# APP_SECRET_KEY signs sessions and is also accepted as the light admin login secret.
APP_SECRET_KEY=
DATA_ENCRYPTION_KEY=
# Optional dedicated admin password hash (also accepted at login).
# Generate with: python scripts/hash_admin_password.py
ADMIN_PASSWORD_HASH=

# Local/test only: allow unauthenticated mock-host admin for Figma wiring.
# Forbidden in staging/production. Prefer signing in with APP_SECRET_KEY (or ADMIN_PASSWORD_HASH).
ALLOW_MOCK_HOST_AUTH=true

# OpenAI (used in later phases)
OPENAI_API_KEY=
OPENAI_ASSESSMENT_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_REASONING_EFFORT=medium

# SQLite tuning (DELETE = portable rollback journal; enable WAL only on validated local disk)
SQLITE_JOURNAL_MODE=DELETE
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_SYNCHRONOUS_MODE=FULL

# Frontend (Vite local dev)
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Comma-separated browser origins. On Railway (same-origin SPA+API), PUBLIC_BASE_URL is enough.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=
FRONTEND_DIST=
ASSESSMENT_CONFIG_PATH=./config/assessment/assessment_model.yaml
SEED_DEMO_DATA=false

# Integrations: mock (deterministic local/demo) or live (Jira Cloud + Azure DevOps APIs)
INTEGRATION_PROVIDER=mock
SEED_DEMO_DATA=false

# Interview AI: mock (deterministic) or live (OpenAI Responses API)
INTERVIEW_PROVIDER=mock

# Deployed DATA_DIR is /data with exactly one app replica and one Uvicorn worker.
