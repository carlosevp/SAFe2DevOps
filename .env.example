# Application
APP_ENV=development
PORT=8000
DATA_DIR=./data

# Derived at runtime when unset:
# DATABASE_URL=sqlite:///./data/db/safedevops.db
# UPLOAD_DIR=./data/uploads
# EXPORT_DIR=./data/exports
# EVIDENCE_DIR=./data/evidence
# BACKUP_DIR=./data/backups
# WORKING_DIR=./data/working

DATABASE_URL=
UPLOAD_DIR=
EXPORT_DIR=
EVIDENCE_DIR=
BACKUP_DIR=
WORKING_DIR=

# Security (required in staging/production; auto-generated in development/test if empty)
APP_SECRET_KEY=
DATA_ENCRYPTION_KEY=
# Generate with: python scripts/hash_admin_password.py
ADMIN_PASSWORD_HASH=

# OpenAI (used in later phases)
OPENAI_API_KEY=
OPENAI_ASSESSMENT_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIPTION_MODEL=gpt-realtime-whisper
OPENAI_REASONING_EFFORT=medium

# SQLite tuning
SQLITE_JOURNAL_MODE=WAL
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_SYNCHRONOUS_MODE=NORMAL

# Frontend (Vite local dev)
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_DIST=

# Deployed DATA_DIR is /data with exactly one app replica and one Uvicorn worker.
